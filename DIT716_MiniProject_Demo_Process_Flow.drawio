        </mxCell>
        <mxCell id="input" value="&lt;b&gt;ผลจาก A4&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;traceable · non-abstained · evidence IDs valid&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="150" width="380" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="eligible" value="&lt;b&gt;ผ่านเกณฑ์เสนอ memory?&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;เฉพาะ candidate ที่ตรวจ trace ได้&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="skip" value="&lt;b&gt;ไม่เขียน LTM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;abstain / มี violation / Unknown&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="465" width="390" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="proposal" value="&lt;b&gt;A3 เสนอ summary&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;บันทึก morphology + candidate + source/evidence IDs&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#fbf0eb;strokeColor=#bf4520;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="465" width="390" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="pending" value="&lt;b&gt;สถานะ pending&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ไม่มี vector · ยังค้นคืนไม่ได้&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#4f5d75;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="585" width="390" height="90" as="geometry"/>
