  <diagram id="dit716-demo-step-3" name="02 Memory write">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="page-title" value="&lt;b&gt;02 Memory write  ·  เขียน Long-term Memory อย่างมี gate&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=27;fontColor=#2d3142;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="44" width="1472" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="page-subtitle" value="&lt;span style='color:#4f5d75'&gt;สาธิตด้วย C1: A3 สร้างข้อเสนอจากหลักฐานที่ A4 ตรวจผ่าน · agent ไม่มีสิทธิ์อนุมัติเอง&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=16;fontColor=#4f5d75;spacing=0;" vertex="1" parent="1">
