          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dit716-demo-step-2" name="01 Agent flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="page-title" value="&lt;b&gt;01 Agent flow  ·  Agent pipeline: C1–C4&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=27;fontColor=#2d3142;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="44" width="1472" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="page-subtitle" value="&lt;span style='color:#4f5d75'&gt;Demo: morphology → context → diagnosis → verification · ตัวแทนแต่ละตัวเป็น deterministic function ใน prototype&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=16;fontColor=#4f5d75;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="94" width="1472" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="cases" value="&lt;b&gt;เลือก synthetic case&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;C1 น้ำขึ้น · C2 flatline · C3 spike · C4 packet delay&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="420" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;A1 · Data Quality&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;คำนวณ flatline / rapid rise / spike / missingness&lt;br&gt;สร้าง evidence ID ของ morphology&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="278" width="420" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;A2 · Hydrology Context&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;บริบทปัจจุบัน + retrieval ผ่าน memory policy&lt;br&gt;แยก future record และ memory analogies&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="410" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;A3 · Diagnostic&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;เสนอ candidate cause + alternatives + evidence IDs&lt;br&gt;ไม่ประกาศผลยืนยัน&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="550" width="420" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;A4 · Verifier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ตรวจ ID / case / availability / claim policy&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#fbf0eb;strokeColor=#bf4520;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="682" width="420" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;Traceable hypothesis&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;C1 / C2 → ใช้เป็น candidate ต่อได้&lt;br&gt;ยังไม่ใช่ cause ที่ยืนยันแล้ว&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="858" width="440" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="abstain" value="&lt;b&gt;Abstain / escalate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;C3 / C4 หรือ claim ผิด policy&lt;br&gt;Unknown + human review&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="858" width="440" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="edge-1" edge="1" parent="1" source="cases" target="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=14;fontColor=#2d3142;labelBackgroundColor=#f5f5f5;">
