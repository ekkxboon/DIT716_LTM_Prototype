        <mxCell id="edge-2" edge="1" parent="1" source="s1" target="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=14;fontColor=#2d3142;labelBackgroundColor=#f5f5f5;">
          <mxGeometry relative="1" as="geometry"/>
