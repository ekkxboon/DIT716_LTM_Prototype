          <mxGeometry x="1100" y="720" width="170" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="kept" value="&lt;b&gt;ยัง pending&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ไม่สร้าง vector · รอ review ต่อ&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="380" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="approved" value="&lt;b&gt;Approved + vectorized&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ค้นคืนได้ตาม role / scope / time policy&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#fbf0eb;strokeColor=#bf4520;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="900" width="420" height="86" as="geometry"/>
        </mxCell>
