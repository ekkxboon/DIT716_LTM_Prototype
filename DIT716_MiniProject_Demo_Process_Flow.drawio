  <diagram id="dit716-demo-step-1" name="00 Overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="720" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="page-title" value="&lt;b&gt;00 Overview  ·  ลำดับการสาธิต Mini-project&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=27;fontColor=#2d3142;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="44" width="1472" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="page-subtitle" value="&lt;span style='color:#4f5d75'&gt;ข้อมูลทั้งหมดเป็น fixture สังเคราะห์ · ไม่มีการเชื่อมต่อสถานีจริงหรือสั่งควบคุมอุปกรณ์&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=16;fontColor=#4f5d75;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="94" width="1472" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;เริ่ม demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;โหลด fixtures + MemoryGateway&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="170" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;STEP 1 · Agent pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;A1 ตรวจ → A2 เติมบริบท → A3 วินิจฉัย → A4 ตรวจ&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#fbf0eb;strokeColor=#bf4520;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="272" width="232" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;STEP 2 · Memory write&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ผลผ่าน A4 → summary pending → reviewer&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="526" y="272" width="232" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;STEP 3 · Retrieval policy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ตรวจสิทธิ์ / scope / เวลา / TTL ก่อนจัดอันดับ&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="802" y="272" width="232" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;STEP 4 · Forgetting&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;หมดอายุหรือเพิกถอน → หยุด serving&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1078" y="272" width="232" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="&lt;b&gt;สรุปผล&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;ดู audit และผลทดลอง P0–P3&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1352" y="300" width="204" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;สิ่งที่ต้องย้ำ&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#5a6580'&gt;Memory ที่ค้นคืนเป็น analogy ไม่ใช่หลักฐานของเหตุการณ์ปัจจุบัน · A4 ตรวจ traceability แต่ไม่รับรองสาเหตุจริง&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=17;fontColor=#2d3142;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="940" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="edge-1" edge="1" parent="1" source="start" target="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Noto Sans Thai,Arial,sans-serif;fontSize=14;fontColor=#2d3142;labelBackgroundColor=#f5f5f5;">
